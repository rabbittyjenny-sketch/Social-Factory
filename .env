# Neon PostgreSQL Connection String
# Get this from your Neon Dashboard: https://console.neon.tech/
DATABASE_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require
VITE_DATABASE_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/account/keys
# Format: sk-ant-...
ANTHROPIC_API_KEY=sk-ant-[your-api-key-here]
VITE_ANTHROPIC_API_KEY=sk-ant-[your-api-key-here]

# Claude Model Configuration
CLAUDE_MODEL=claude-haiku-4-5-20251001
VITE_CLAUDE_MODEL=claude-haiku-4-5-20251001
